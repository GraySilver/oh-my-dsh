{
  "name": "@graysilver/oh-my-dsh-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "OhMyDSH macOS Desktop shell",
  "author": "GraySilver",
  "type": "module",
  "main": "dist/main.mjs",
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm run build && electron .",
    "package": "pnpm run build && node scripts/prepare-native-deps.mjs && node scripts/prepare-runtime-peers.mjs && electron-builder --mac --universal",
    "postpackage": "node scripts/verify-packaged-runtime.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@graysilver/oh-my-dsh": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.graysilver.ohmydsh",
    "productName": "OhMyDSH",
    "icon": "assets/icon.icns",
    "asar": false,
    "afterPack": "scripts/complete-runtime-deps.mjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools",
      "x64ArchFiles": "**/*darwin-{x64,arm64}/**/*"
    },
    "dmg": {
      "title": "OhMyDSH"
    }
  }
}
